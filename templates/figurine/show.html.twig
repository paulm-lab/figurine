{% extends 'base.html.twig' %}{% block title %}{{ figurine.title }} · FIGURINEVITE{% endblock %}{% block body %}<a class="text-decoration-none" href="{{ path('app_figurine_index') }}">← Retour à la collection</a><div class="row g-4 g-lg-5 mt-1 align-items-start"><div class="col-lg-7 text-center"><img class="figurine-detail" src="{{ vich_uploader_asset(figurine, 'imageFile') ?: asset('images/figurine-placeholder.svg') }}" alt="{{ figurine.title }}"></div><div class="col-lg-5"><p class="text-uppercase text-secondary small fw-bold mb-1">Figurine partagée</p><h1 class="display-6 fw-bold">{{ figurine.title }}</h1><p class="display-6 text-primary fw-semibold">{{ figurine.prix|number_format(2, ',', ' ') }} €</p><h2 class="h5 mt-4">Description</h2><p class="text-secondary" style="white-space:pre-line">{{ figurine.description ?: 'Aucune description.' }}</p><hr><p class="mb-1">Partagée par <strong>{{ figurine.author.firstname }}</strong></p><p class="small text-secondary mb-1">Créée le {{ figurine.createdAt|date('d/m/Y à H:i') }}</p><p class="small text-secondary">Modifiée le {{ figurine.updatedAt|date('d/m/Y à H:i') }}</p>{% if app.user and figurine.author == app.user %}<div class="d-flex gap-2 mt-4"><a class="btn btn-primary" href="{{ path('app_figurine_edit', {id: figurine.id}) }}">Modifier</a><form method="post" action="{{ path('app_figurine_delete', {id: figurine.id}) }}" onsubmit="return confirm('Supprimer cette figurine ?');"><input type="hidden" name="_token" value="{{ csrf_token('delete-figurine-' ~ figurine.id) }}"><button class="btn btn-outline-danger">Supprimer</button></form></div>{% endif %}</div></div>{% endblock %}
