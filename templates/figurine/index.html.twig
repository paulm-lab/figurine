{% extends 'base.html.twig' %}
{% block title %}Collection · FIGURINEVITE{% endblock %}
{% block body %}<div class="d-flex justify-content-between align-items-center mb-4"><div><p class="text-uppercase text-secondary small fw-bold mb-1">Communauté</p><h1 class="h2 mb-0">Les figurines</h1></div>{% if app.user %}<a class="btn btn-primary" href="{{ path('app_figurine_create') }}">Ajouter une figurine</a>{% endif %}</div>{% if figurines is empty %}<div class="card p-5 text-center"><p class="mb-0 text-secondary">Aucune figurine pour le moment.</p></div>{% else %}<div class="row g-4">{% for figurine in figurines %}{% include 'figurine/_card.html.twig' with {figurine: figurine} %}{% endfor %}</div>{% endif %}{% endblock %}
