<div class="col-sm-6 col-lg-4"><article class="card h-100 overflow-hidden"><a href="{{ path('app_figurine_show', {id: figurine.id}) }}" class="text-decoration-none"><img class="card-img-top figurine-thumb" src="{{ vich_uploader_asset(figurine, 'imageFile') ?: asset('images/figurine-placeholder.svg') }}" alt="{{ figurine.title }}"></a><div class="card-body d-flex flex-column"><div class="d-flex justify-content-between align-items-start gap-2"><h3 class="h5 card-title">{{ figurine.title }}</h3><span class="badge text-bg-primary fs-6">{{ figurine.prix|number_format(2, ',', ' ') }} €</span></div><p class="text-secondary small mb-2">Par {{ figurine.author.firstname }}</p><p class="card-text text-secondary flex-grow-1">{{ figurine.description ? figurine.description|length > 110 ? figurine.description|slice(0, 110) ~ '…' : figurine.description : 'Aucune description.' }}</p><a class="btn btn-outline-primary mt-2" href="{{ path('app_figurine_show', {id: figurine.id}) }}">Voir la figurine</a></div></article></div>
