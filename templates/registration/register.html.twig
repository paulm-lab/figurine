{% extends 'base.html.twig' %}{% block title %}Inscription · FIGURINEVITE{% endblock %}{% block body %}<div class="row justify-content-center"><div class="col-md-8 col-lg-6"><div class="card p-4 p-md-5"><p class="text-uppercase text-secondary small fw-bold mb-1">Rejoindre la communauté</p><h1 class="h2 mb-4">Créer un compte</h1>{{ form_start(form) }}{{ form_errors(form) }}<div class="mb-3">{{ form_row(form.firstname) }}</div><div class="mb-3">{{ form_row(form.lastname) }}</div><div class="mb-3">{{ form_row(form.email) }}</div><div class="mb-3">{{ form_row(form.imageFile) }}</div><div class="mb-4">{{ form_row(form.plainPassword) }}</div><button class="btn btn-primary w-100">Créer mon compte</button>{{ form_end(form) }}<p class="text-secondary mt-4 mb-0 text-center">Déjà inscrit ? <a href="{{ path('app_login') }}">Connectez-vous</a>.</p></div></div></div>{% endblock %}
