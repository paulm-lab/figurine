{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié · FIGURINEVITE{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="card p-4 p-md-5">
                <p class="text-uppercase text-secondary small fw-bold mb-1">Récupération du compte</p>
                <h1 class="h2 mb-3">Mot de passe oublié</h1>
                <p class="text-secondary">Saisissez l’adresse e-mail associée à votre compte. Si elle existe, un lien valable une heure vous sera envoyé.</p>

                {{ form_start(form) }}
                    {{ form_errors(form) }}
                    <div class="mb-4">{{ form_row(form.email) }}</div>
                    <button class="btn btn-primary w-100">Envoyer le lien</button>
                {{ form_end(form) }}

                <p class="text-secondary mt-4 mb-0 text-center"><a href="{{ path('app_login') }}">Retour à la connexion</a></p>
            </div>
        </div>
    </div>
{% endblock %}
