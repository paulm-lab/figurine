{% extends 'base.html.twig' %}{% block title %}Connexion · FIGURINEVITE{% endblock %}{% block body %}<div class="row justify-content-center"><div class="col-md-7 col-lg-5"><div class="card p-4 p-md-5"><p class="text-uppercase text-secondary small fw-bold mb-1">Ravi de vous revoir</p><h1 class="h2 mb-4">Connexion</h1>{% if error %}<div class="alert alert-danger" role="alert">Adresse e-mail ou mot de passe incorrect.</div>{% endif %}<form method="post" action="{{ path('app_login') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}"><div class="mb-3"><label class="form-label" for="inputEmail">Adresse e-mail</label><input id="inputEmail" class="form-control" type="email" name="email" value="{{ last_username }}" autocomplete="email" required autofocus></div><div class="mb-4"><label class="form-label" for="inputPassword">Mot de passe</label><input id="inputPassword" class="form-control" type="password" name="password" autocomplete="current-password" required></div><button class="btn btn-primary w-100">Se connecter</button></form><p class="text-secondary mt-4 mb-0 text-center">Pas encore de compte ? <a href="{{ path('app_register') }}">Inscrivez-vous</a>.</p></div></div></div>{% endblock %}
