{% extends 'base.html.twig' %}

{% block title %}Réinitialiser le mot de passe · FIGURINEVITE{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="card p-4 p-md-5">
                <p class="text-uppercase text-secondary small fw-bold mb-1">Sécurité du compte</p>
                <h1 class="h2 mb-4">Nouveau mot de passe</h1>

                {% if form is not null %}
                    {{ form_start(form) }}
                        {{ form_errors(form) }}
                        <div class="mb-3">{{ form_row(form.plainPassword.first) }}</div>
                        <div class="mb-4">{{ form_row(form.plainPassword.second) }}</div>
                        <button class="btn btn-primary w-100">Enregistrer le nouveau mot de passe</button>
                    {{ form_end(form) }}
                {% else %}
                    <p class="text-secondary">Le lien n’est plus valide. Demandez-en un nouveau pour continuer.</p>
                    <a class="btn btn-primary w-100" href="{{ path('app_forgot_password') }}">Demander un nouveau lien</a>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
