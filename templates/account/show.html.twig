{% extends 'base.html.twig' %}{% block title %}Mon compte · FIGURINEVITE{% endblock %}{% block body %}<div class="row justify-content-center"><div class="col-lg-8"><div class="card p-4 p-md-5"><div class="d-flex flex-column flex-sm-row align-items-center gap-4"><img class="profile-image" src="{{ vich_uploader_asset(user, 'imageFile') ?: asset('images/user-placeholder.svg') }}" alt="Photo de {{ user.firstname }}"><div><p class="text-uppercase text-secondary small fw-bold mb-1">Espace personnel</p><h1 class="h2">{{ user.firstname }} {{ user.lastname }}</h1><p class="text-secondary mb-1">{{ user.email }}</p><p class="small text-secondary">Membre depuis le {{ user.createdAt|date('d/m/Y') }}</p><a class="btn btn-primary" href="{{ path('app_account_edit') }}">Modifier mon compte</a></div></div></div></div></div>{% endblock %}
