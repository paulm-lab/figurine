<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="FIGURINEVITE, le site de partage de figurines.">
    <title>{% block title %}FIGURINEVITE{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
    <style>
        :root { --ink: #172033; --accent: #7655d9; --surface: #f5f6fa; }
        body { background: var(--surface); color: var(--ink); min-height: 100vh; }
        .navbar-brand { font-weight: 800; letter-spacing: .04em; }
        .hero { background: linear-gradient(120deg, #201846, #5e42ad); color: white; border-radius: 1.25rem; }
        .card { border: 0; box-shadow: 0 8px 24px rgba(25, 30, 55, .07); }
        .figurine-thumb { height: 220px; object-fit: cover; background: #e9e7f2; }
        .figurine-detail { width: 100%; max-width: 600px; max-height: 600px; object-fit: contain; background: #f0eff5; border-radius: 1rem; }
        .profile-image { width: 160px; height: 160px; object-fit: cover; border-radius: 50%; }
        footer { color: #707789; }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark" style="background:#172033"><div class="container">
    <a class="navbar-brand" href="{{ path('app_home') }}">◆ FIGURINEVITE</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Ouvrir la navigation"><span class="navbar-toggler-icon"></span></button>
    <div class="collapse navbar-collapse" id="mainNav"><div class="navbar-nav me-auto"><a class="nav-link" href="{{ path('app_figurine_index') }}">Les figurines</a>{% if app.user %}<a class="nav-link" href="{{ path('app_figurine_create') }}">Ajouter une figurine</a>{% endif %}</div><div class="navbar-nav align-items-lg-center gap-lg-2">{% if app.user %}<a class="nav-link" href="{{ path('app_account_show') }}">Mon compte</a><form method="post" action="{{ path('app_logout') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="btn btn-outline-light btn-sm">Déconnexion</button></form>{% else %}<a class="nav-link" href="{{ path('app_login') }}">Connexion</a><a class="btn btn-light btn-sm" href="{{ path('app_register') }}">Créer un compte</a>{% endif %}</div></div>
</div></nav>
<main class="container py-4 py-lg-5">{% for type, messages in app.flashes %}{% set alertClass = type == 'success' ? 'success' : (type == 'danger' or type == 'error' ? 'danger' : 'info') %}{% for message in messages %}<div class="alert alert-{{ alertClass }} alert-dismissible fade show" role="alert">{{ message|nl2br }}<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button></div>{% endfor %}{% endfor %}{% block body %}{% endblock %}</main>
<footer class="container py-4 text-center small">FIGURINEVITE · Partageons nos collections</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
